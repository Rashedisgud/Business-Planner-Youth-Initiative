# Copy this file to .env and fill in real values before running the backend.

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase (Project Settings -> API, in your Supabase dashboard)
# Use the SERVICE ROLE key here (backend only, never expose it to the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Founder/about section: whoever knows this password can edit the founder
# name/bio/photo from the app. Pick your own private password - do not share it.
ADMIN_PASSWORD=
